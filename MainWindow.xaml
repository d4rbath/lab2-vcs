<Window x:Class="IPPRPO_lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вариант 7 - Система отправки уведомлений" Height="593" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Параметры и каналы -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <!-- Данные пользователя -->
            <GroupBox Header="Данные пользователя" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Имя:" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtName" Text="Антон" Margin="0,0,0,8"/>

                    <TextBlock Text="Email:" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtEmail" Text="d3rbath@gmail.com" Margin="0,0,0,8"/>

                    <TextBlock Text="Телефон:" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtPhone" Text="+375298460919" Margin="0,0,0,8"/>

                    <TextBlock Text="Telegram:" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtTelegram" Text="@qweeeewqqww"/>
                </StackPanel>
            </GroupBox>

            <!-- Выбор каналов отправки -->
            <GroupBox Header="Выбор каналов (INotifier)" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <CheckBox x:Name="ChkEmail" Content="EmailNotifier (smtp.mail.com)" IsChecked="True" Margin="0,3" Foreground="Black"/>
                    <CheckBox x:Name="ChkSms" Content="SmsNotifier (api.sms.by)" IsChecked="True" Margin="0,3" Foreground="Black"/>
                    <CheckBox x:Name="ChkPush" Content="PushNotifier (Firebase_Key)" IsChecked="True" Margin="0,3" Background="White" Foreground="Black"/>
                    <Separator Margin="0,5"/>
                    <CheckBox x:Name="ChkTelegram" Content="TelegramNotifier (BotToken)" IsChecked="True" Foreground="#0088cc" FontWeight="Bold" Margin="0,3"/>
                </StackPanel>
            </GroupBox>

            <!-- Текст сообщения -->
            <GroupBox Header="Текст сообщения" Margin="0,0,0,10" Padding="10">
                <TextBox x:Name="TxtMessage" Text="qeezzzxc!" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
            </GroupBox>

            <!-- Кнопка отправки -->
            <Button x:Name="BtnSend" Content="Отправить уведомления" Height="40" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" 
                    Click="BtnSend_Click"/>
        </StackPanel>

        <!-- Правая панель: Лог результатов -->
        <GroupBox Grid.Column="1" Header="Журнал отправки (Консоль вывода)" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="LstLog" Grid.Row="0" FontFamily="Consolas" FontSize="12" Background="#1E1E1E" Foreground="#DCDCDC"/>
                <Button x:Name="BtnClearLog" Grid.Row="1" Content="Очистить лог" HorizontalAlignment="Right" Margin="0,10,0,0" Width="100" Height="25" Click="BtnClearLog_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>